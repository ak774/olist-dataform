config {
  type: "table",

  schema: "olist_gold",

  name: "fact_payments_order_quality",

  tags: ["phase_10", "quality"]
}

SELECT

  COUNT(*) AS total_payment_records,

  COUNT(DISTINCT order_id) AS orders_with_payments,

  COUNTIF(has_order_fact) AS payments_with_order_fact,

  COUNTIF(NOT has_order_fact) AS payments_without_order_fact,

  SAFE_DIVIDE(
    COUNTIF(has_order_fact),
    COUNT(*)
  ) AS order_fact_coverage_rate,

  COUNTIF(is_installment_payment) AS installment_payment_records,

  COUNTIF(is_credit_card) AS credit_card_payment_records,

  COUNTIF(is_voucher) AS voucher_payment_records,

  COUNTIF(is_boleto) AS boleto_payment_records

FROM ${ref("fact_payments")}