config {
  type: "table",

  schema: "olist_gold",

  name: "fact_reviews",

  tags: ["phase_9", "gold", "fact"],

  assertions: {
    nonNull: [
      "review_id",
      "order_id",
      "review_score"
    ],

    uniqueKey: [
      "review_id",
      "order_id"
    ]
  },

  bigquery: {
    partitionBy: "DATE(review_creation_date)",

    clusterBy: [
      "review_score",
      "customer_unique_id"
    ]
  }
}

WITH reviews_enriched AS (

  SELECT

    r.review_id,

    r.order_id,

    r.review_score,

    r.review_comment_title,

    r.review_comment_message,

    r.review_creation_ts as review_creation_date,

    r.review_answer_ts as review_answer_timestamp,

    fo.customer_id,

    fo.customer_unique_id,

    fo.order_status,

    fo.order_purchase_timestamp,

    fo.order_delivered_customer_date,

    CASE
      WHEN fo.order_id IS NOT NULL THEN TRUE
      ELSE FALSE
    END AS has_order_fact,

    CASE
      WHEN r.review_comment_title IS NOT NULL
       AND TRIM(r.review_comment_title) != ''
      THEN TRUE
      ELSE FALSE
    END AS has_review_title,

    CASE
      WHEN r.review_comment_message IS NOT NULL
       AND TRIM(r.review_comment_message) != ''
      THEN TRUE
      ELSE FALSE
    END AS has_review_message

  FROM ${ref("reviews")} AS r

  LEFT JOIN ${ref("fact_orders")} AS fo
    ON r.order_id = fo.order_id

),

review_metrics AS (

  SELECT

    *,

    CASE
      WHEN has_review_title = TRUE
        OR has_review_message = TRUE
      THEN TRUE
      ELSE FALSE
    END AS has_review_comment,


    -- Response time is only valid when answer occurs
    -- on or after review creation.
    CASE
      WHEN review_creation_date IS NOT NULL
       AND review_answer_timestamp IS NOT NULL
       AND review_answer_timestamp >= review_creation_date
      THEN TIMESTAMP_DIFF(
        review_answer_timestamp,
        review_creation_date,
        HOUR
      )
    END AS review_response_time_hours,


    CASE
      WHEN review_creation_date IS NULL
        OR review_answer_timestamp IS NULL
      THEN NULL

      WHEN review_answer_timestamp >= review_creation_date
      THEN TRUE

      ELSE FALSE
    END AS is_valid_review_response_sequence,


    CASE
      WHEN review_score IN (1, 2) THEN 'negative'
      WHEN review_score = 3 THEN 'neutral'
      WHEN review_score IN (4, 5) THEN 'positive'
      ELSE 'unknown'
    END AS review_sentiment


  FROM reviews_enriched

)

SELECT

  -- ============================================================
  -- Keys
  -- ============================================================

  review_id,

  order_id,


  -- ============================================================
  -- Review attributes
  -- ============================================================

  review_score,

  review_comment_title,

  review_comment_message,

  review_creation_date,

  review_answer_timestamp,


  -- ============================================================
  -- Order/customer context
  -- ============================================================

  customer_id,

  customer_unique_id,

  order_status,

  order_purchase_timestamp,

  order_delivered_customer_date,


  -- ============================================================
  -- Derived review metrics
  -- ============================================================

  review_response_time_hours,

  review_sentiment,


  -- ============================================================
  -- Review content flags
  -- ============================================================

  has_review_title,

  has_review_message,

  has_review_comment,


  -- ============================================================
  -- Data-quality flags
  -- ============================================================

  is_valid_review_response_sequence,

  has_order_fact

FROM review_metrics