config {
  type: "assertion",

  schema: "olist_assertions",

  name: "fact_orders_valid_values",

  tags: ["phase_10", "quality"]
}

SELECT
  order_id,
  order_status,
  approval_time_hours,
  carrier_handoff_time_hours,
  actual_delivery_time_days,
  estimated_delivery_time_days,
  delivery_delay_days

FROM ${ref("fact_orders")}

WHERE

  order_id IS NULL

  OR order_purchase_timestamp IS NULL

  OR approval_time_hours < 0

  OR carrier_handoff_time_hours < 0

  OR actual_delivery_time_days < 0

  OR estimated_delivery_time_days < 0