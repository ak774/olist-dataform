config {
  type: "table",

  schema: "olist_gold",

  name: "mart_sales_summary",

  tags: ["phase_9", "gold", "mart"],

  bigquery: {
    partitionBy: "purchase_date"
  }
}

WITH order_daily AS (

  SELECT

    DATE(order_purchase_timestamp) AS purchase_date,

    COUNT(DISTINCT order_id) AS total_orders,

    COUNTIF(is_delivered) AS delivered_orders,

    COUNTIF(is_canceled) AS canceled_orders,

    COUNT(DISTINCT customer_id) AS distinct_customers,

    COUNT(DISTINCT customer_unique_id) AS distinct_unique_customers

  FROM ${ref("fact_orders")}

  WHERE order_purchase_timestamp IS NOT NULL

  GROUP BY purchase_date

),

item_daily AS (

  SELECT

    DATE(order_purchase_timestamp) AS purchase_date,

    COUNT(*) AS total_items_sold,

    COUNT(DISTINCT order_id) AS orders_with_items,

    COUNT(DISTINCT product_id) AS distinct_products_sold,

    COUNT(DISTINCT seller_id) AS active_sellers,

    SUM(item_price) AS total_item_revenue,

    SUM(freight_value) AS total_freight_revenue,

    SUM(gross_item_value) AS total_gross_value

  FROM ${ref("fact_order_items")}

  WHERE order_purchase_timestamp IS NOT NULL

  GROUP BY purchase_date

),

payment_daily AS (

  SELECT

    DATE(order_purchase_timestamp) AS purchase_date,

    COUNT(*) AS total_payment_records,

    COUNT(DISTINCT order_id) AS orders_with_payments,

    SUM(payment_value) AS total_payment_value,

    COUNTIF(payment_type = 'credit_card') AS credit_card_payment_records,

    COUNTIF(payment_type = 'boleto') AS boleto_payment_records,

    COUNTIF(payment_type = 'voucher') AS voucher_payment_records,

    COUNTIF(payment_type = 'debit_card') AS debit_card_payment_records

  FROM ${ref("fact_payments")}

  WHERE order_purchase_timestamp IS NOT NULL

  GROUP BY purchase_date

)

SELECT

  -- ============================================================
  -- Date
  -- ============================================================

  o.purchase_date,

  DATE_TRUNC(o.purchase_date, MONTH) AS purchase_month,

  EXTRACT(YEAR FROM o.purchase_date) AS purchase_year,

  EXTRACT(MONTH FROM o.purchase_date) AS purchase_month_number,


  -- ============================================================
  -- Order KPIs
  -- ============================================================

  o.total_orders,

  o.delivered_orders,

  o.canceled_orders,

  o.distinct_customers,

  o.distinct_unique_customers,


  -- ============================================================
  -- Item KPIs
  -- ============================================================

  COALESCE(i.total_items_sold, 0) AS total_items_sold,

  COALESCE(i.orders_with_items, 0) AS orders_with_items,

  COALESCE(i.distinct_products_sold, 0) AS distinct_products_sold,

  COALESCE(i.active_sellers, 0) AS active_sellers,

  COALESCE(i.total_item_revenue, 0) AS total_item_revenue,

  COALESCE(i.total_freight_revenue, 0) AS total_freight_revenue,

  COALESCE(i.total_gross_value, 0) AS total_gross_value,


  -- ============================================================
  -- Payment KPIs
  -- ============================================================

  COALESCE(p.total_payment_records, 0) AS total_payment_records,

  COALESCE(p.orders_with_payments, 0) AS orders_with_payments,

  COALESCE(p.total_payment_value, 0) AS total_payment_value,

  COALESCE(
    p.credit_card_payment_records,
    0
  ) AS credit_card_payment_records,

  COALESCE(
    p.boleto_payment_records,
    0
  ) AS boleto_payment_records,

  COALESCE(
    p.voucher_payment_records,
    0
  ) AS voucher_payment_records,

  COALESCE(
    p.debit_card_payment_records,
    0
  ) AS debit_card_payment_records,


  -- ============================================================
  -- Derived Sales KPIs
  -- ============================================================

  SAFE_DIVIDE(
    COALESCE(i.total_gross_value, 0),
    o.total_orders
  ) AS avg_gross_value_per_order,


  SAFE_DIVIDE(
    COALESCE(i.total_item_revenue, 0),
    o.total_orders
  ) AS avg_item_revenue_per_order,


  SAFE_DIVIDE(
    COALESCE(i.total_freight_revenue, 0),
    o.total_orders
  ) AS avg_freight_per_order,


  SAFE_DIVIDE(
    COALESCE(i.total_items_sold, 0),
    o.total_orders
  ) AS avg_items_per_order,


  SAFE_DIVIDE(
    COALESCE(i.total_item_revenue, 0),
    COALESCE(i.total_items_sold, 0)
  ) AS avg_item_price,


  -- ============================================================
  -- Delivery KPIs
  -- ============================================================

  SAFE_DIVIDE(
    o.delivered_orders,
    o.total_orders
  ) AS delivery_rate,


  SAFE_DIVIDE(
    o.canceled_orders,
    o.total_orders
  ) AS cancellation_rate


FROM order_daily AS o

LEFT JOIN item_daily AS i
  ON o.purchase_date = i.purchase_date

LEFT JOIN payment_daily AS p
  ON o.purchase_date = p.purchase_date