config {
  type: "table",
  schema: "olist_silver",
  name: "sellers_quality_metrics",
  tags: ["phase_10", "quality", "silver"]
}

SELECT
  COUNT(*) AS total_sellers,

  COUNT(DISTINCT seller_id) AS distinct_sellers,

  COUNT(DISTINCT seller_state) AS distinct_states,

  COUNT(DISTINCT seller_city) AS distinct_cities,

  COUNTIF(
    seller_zip_code_prefix IS NULL
  ) AS null_zip_code_count,

  COUNTIF(
    seller_city IS NULL
    OR seller_city = ''
  ) AS invalid_city_count,

  COUNTIF(
    seller_state IS NULL
    OR LENGTH(seller_state) != 2
  ) AS invalid_state_count

FROM ${ref("sellers")}