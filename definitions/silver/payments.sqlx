config {
  type: "table",

  schema: "olist_silver",

  name: "payments",
  
  tags: ["phase_8", "silver"],
  assertions: {
    nonNull: [
      "order_id",
      "payment_sequential",
      "payment_type",
      "payment_value"
    ],

    uniqueKey: [
      "order_id",
      "payment_sequential"
    ],

    rowConditions: [
      "payment_sequential > 0",
      "payment_value >= 0"
    ]
  },

  bigquery: {
    clusterBy: [
      "order_id",
      "payment_type"
    ]
  }
}

WITH cleaned AS (

  SELECT
    TRIM(order_id) AS order_id,

    SAFE_CAST(payment_sequential AS INT64) AS payment_sequential,

    LOWER(TRIM(payment_type)) AS payment_type,

    SAFE_CAST(payment_installments AS INT64) AS payment_installments,

    SAFE_CAST(payment_value AS NUMERIC) AS payment_value

  FROM ${ref("payments_staging")}

),

deduplicated AS (

  SELECT *
  FROM cleaned

  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY order_id, payment_sequential
    ORDER BY payment_value DESC
  ) = 1

)

SELECT
  order_id,
  payment_sequential,
  payment_type,
  payment_installments,
  payment_value

FROM deduplicated

WHERE order_id IS NOT NULL
  AND payment_sequential IS NOT NULL