config {
  type: "assertion",
  schema: "olist_assertions",
  name: "reviews_valid_dates",
  tags: ["phase_10", "quality", "silver"]
}

SELECT
  review_id,
  order_id,
  review_creation_ts,
  review_answer_ts

FROM ${ref("reviews")}

WHERE
  review_creation_ts IS NULL

  OR (
    review_answer_ts IS NOT NULL
    AND review_answer_ts < review_creation_ts
  )